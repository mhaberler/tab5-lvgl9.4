{
	"name": "example-svelte",
	"version": "0.0.1",
	"type": "module",
	"main": "build/index.js",
	"engines": {
		"node": ">=18.0.0",
		"npm": ">=10.0.0"
	},
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build && gzip -c ./dist/favicon.png > ./dist/favicon.png.gz",
		"generate": "npx svelteesp32 -e webserver -s dist -o ../../include/svelteesp32webserver.h  --etag=true --gzip=true",
		"preview": "vite preview",
		"ts:check": "svelte-check --tsconfig ./tsconfig.json",
		"format:check": "prettier --check .",
		"format:fix": "prettier --write .",
		"lint:check": "eslint .",
		"lint:fix": "eslint --fix .",
		"all": "npm run format:fix && npm run lint:fix && npm run ts:check && npm run build",
		"npm:reinstall": "rm -rf ./node_modules && rm -f ./package-lock.json && bun i && bun i"
	},
	"dependencies": {
		"mqtt": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.4",
		"@eslint/js": "^10.0.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.1",
		"@tsconfig/svelte": "^5.0.8",
		"@typescript-eslint/eslint-plugin": "^8.56.1",
		"@typescript-eslint/parser": "^8.56.1",
		"eslint": "^10.0.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"eslint-plugin-svelte": "^3.15.0",
		"eslint-plugin-unicorn": "^63.0.0",
		"flowbite-svelte": "^1.31.0",
		"flowbite-svelte-icons": "^3.1.0",
		"globals": "^17.3.0",
		"postcss": "^8.5.6",
		"postcss-load-config": "^6.0.1",
		"svelte": "^5.53.5",
		"svelte-check": "^4.4.4",
		"svelte-eslint-parser": "^1.5.1",
		"svelte-preprocess": "^6.0.3",
		"svelteesp32": "^2.1.0",
		"tailwindcss": "^4.2.1",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vite-plugin-devtools-json": "^0.1.0"
	}
}
